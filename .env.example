# Copy to .env.local and fill in. Never commit .env.local.

# --- Neon (§12) ------------------------------------------------------------
# Pooled connection, used by request handlers.
DATABASE_URL=
# Direct connection, used by drizzle-kit migrations and the seed script.
DATABASE_URL_UNPOOLED=

# --- Better Auth (§05.1) ---------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Customer portal (§05.4) -----------------------------------------------
# Mixed into the portal token hash, so a leaked database does not hand over
# working statement links. openssl rand -base64 32
PORTAL_TOKEN_PEPPER=

# --- Cloudflare R2, photos and signatures (§12) ----------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- Vercel Cron (§09) -----------------------------------------------------
CRON_SECRET=

# --- Seed script only ------------------------------------------------------
SEED_ORG_NAME=Bismi Scaffolding
SEED_ADMIN_EMAIL=owner@example.com
SEED_ADMIN_NAME=Yard Owner
# At least 10 characters. The seed refuses to run without it.
SEED_ADMIN_PASSWORD=

# Printed at the top of every bill (§09). Re-running the seed updates these,
# so this is how you correct them until the settings screen lands at M7.
SEED_YARD_ADDRESS=
SEED_YARD_PHONE=
# Days from issue to a bill's due date. Drives the overdue reminder queue.
SEED_PAYMENT_TERMS_DAYS=7
# Minimum rental days per issue lot. 0 = charge the days actually held (D57).
SEED_MINIMUM_DAYS=0
